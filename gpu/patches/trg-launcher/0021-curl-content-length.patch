+struct HeaderBlock {
+  int status = 0;
+  long long length = -1;
+  bool complete = false;
+};
+
+// The response headers curl dumps to stderr (-D): the last block is this hop's own response.
+HeaderBlock LastHeaderBlock(const std::string& text) {
+  HeaderBlock block;
+  size_t at = 0;
+  for (size_t end; (end = text.find('\n', at)) != std::string::npos; at = end + 1) {
+    std::string line = text.substr(at, end - at);
+    if (!line.empty() && line.back() == '\r') {
+      line.pop_back();
+    }
+    if (line.rfind("HTTP/", 0) == 0) {
+      block = HeaderBlock{};
+      const size_t space = line.find(' ');
+      block.status = space == std::string::npos ? 0 : std::atoi(line.c_str() + space + 1);
+    } else if (block.status && !block.complete) {
+      const size_t colon = line.find(':');
+      if (line.empty()) {
+        block.complete = true;
+      } else if (colon != std::string::npos && Lower(line.substr(0, colon)) == "content-length") {
+        char* parsed = nullptr;
+        const char* value = line.c_str() + colon + 1;
+        const long long length = std::strtoll(value, &parsed, 10);
+        block.length = parsed != value && length >= 0 ? length : -1;
+      }
+    }
+  }
+  return block;
+}
