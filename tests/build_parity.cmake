# The supported-build and platform feature contract. sotb_platform_contract.h lists the production sources this
# configuration compiles into the shipped programs, so a feature left out of one platform's targets is reported there.

if (WIN32)
    set(SOTB_SHIPPED_TARGETS shadow_of_the_beast trg-updater)
else()
    set(SOTB_SHIPPED_TARGETS shadow_of_the_beast) # an AppImage replaces itself, with no helper program
endif()

function(sotb_parity_collect target)
    if (target MATCHES "^\\$<LINK_ONLY:(.+)>$")
        set(target "${CMAKE_MATCH_1}")
    endif()
    if (NOT TARGET "${target}")
        return()
    endif()
    get_target_property(aliased "${target}" ALIASED_TARGET)
    if (aliased)
        set(target "${aliased}")
    endif()
    get_property(seen GLOBAL PROPERTY SOTB_PARITY_TARGETS)
    if ("${target}" IN_LIST seen)
        return()
    endif()
    set_property(GLOBAL APPEND PROPERTY SOTB_PARITY_TARGETS "${target}")
    get_target_property(imported "${target}" IMPORTED)
    if (imported)
        return()
    endif()
    get_target_property(directory "${target}" SOURCE_DIR)
    get_target_property(sources "${target}" SOURCES)
    foreach (source IN LISTS sources)
        if (source MATCHES "^\\$<" OR source MATCHES "-NOTFOUND$")
            continue()
        endif()
        cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY "${directory}" NORMALIZE OUTPUT_VARIABLE absolute)
        cmake_path(IS_PREFIX CMAKE_SOURCE_DIR "${absolute}" NORMALIZE inside)
        cmake_path(IS_PREFIX CMAKE_BINARY_DIR "${absolute}" NORMALIZE generated)
        if (inside AND NOT generated)
            cmake_path(RELATIVE_PATH absolute BASE_DIRECTORY "${CMAKE_SOURCE_DIR}" OUTPUT_VARIABLE relative)
            set_property(GLOBAL APPEND PROPERTY SOTB_PARITY_SOURCES "${relative}")
        endif()
    endforeach()
    foreach (property IN ITEMS LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
        get_target_property(libraries "${target}" ${property})
        foreach (library IN LISTS libraries)
            sotb_parity_collect("${library}")
        endforeach()
    endforeach()
endfunction()

function(sotb_add_parity_tests)
    set_property(GLOBAL PROPERTY SOTB_PARITY_TARGETS "")
    set_property(GLOBAL PROPERTY SOTB_PARITY_SOURCES "")
    set(shipped "")
    foreach (target IN LISTS SOTB_SHIPPED_TARGETS)
        if (TARGET ${target})
            list(APPEND shipped ${target})
            sotb_parity_collect(${target})
        endif()
    endforeach()
    get_property(sources GLOBAL PROPERTY SOTB_PARITY_SOURCES)
    list(REMOVE_DUPLICATES sources)
    list(SORT sources)
    set(source_lines "")
    foreach (source IN LISTS sources)
        string(APPEND source_lines "    \"${source}\",\n")
    endforeach()
    if (WIN32)
        set(platform windows)
    else()
        string(TOLOWER "${CMAKE_SYSTEM_NAME}" platform)
    endif()
    string(JOIN " " shipped_text ${shipped})
    string(JOIN " " expected_text ${SOTB_SHIPPED_TARGETS})
    file(CONFIGURE OUTPUT ${CMAKE_BINARY_DIR}/generated/sotb_platform_contract.h CONTENT
"#define SOTB_CONTRACT_PLATFORM \"@platform@\"
#define SOTB_CONTRACT_SHIPPED_TARGETS \"@shipped_text@\"
#define SOTB_CONTRACT_EXPECTED_TARGETS \"@expected_text@\"
static const char *const sotb_contract_sources[] = {
@source_lines@    0};
" @ONLY)

    set(root ${PROJECT_SOURCE_DIR})
    add_executable(sotb-build-parity-tests EXCLUDE_FROM_ALL ${root}/tests/build_parity_tests.cpp
        ${root}/launcher/game_profile.cpp ${root}/src/guest_display.c ${root}/src/guest_hud.c
        ${root}/src/guest_patches.c ${root}/src/guest_ultrawide.c ${root}/src/isa_emulate.c ${root}/src/lzcnt_compat.c
        ${root}/src/psn_notice.c ${root}/src/skip_intro.c ${root}/src/sotb_exit_game.c ${root}/src/sotb_exit_game_l10n.c
        ${root}/src/sotb_menu_buttons.c ${root}/src/sotb_prompt_assets.c ${root}/src/sotb_prompt_assets_data.c)
    target_include_directories(sotb-build-parity-tests PRIVATE ${root}/src ${root}/launcher ${root}/tests
        ${root}/gpu/shim ${CMAKE_BINARY_DIR}/generated)
    target_compile_definitions(sotb-build-parity-tests PRIVATE SOTB_SOURCE_DIR="${root}")
    set_target_properties(sotb-build-parity-tests PROPERTIES CXX_STANDARD 20 CXX_STANDARD_REQUIRED ON CXX_EXTENSIONS OFF)
    target_compile_options(sotb-build-parity-tests PRIVATE -Wall -Wextra)
    if (NOT WIN32)
        target_link_libraries(sotb-build-parity-tests PRIVATE m)
    endif()
endfunction()

# Every headless test target of this configuration, one per line, for tools/test-linux.sh.
function(sotb_write_test_targets)
    set(tests "")
    foreach (directory IN ITEMS "${CMAKE_SOURCE_DIR}" "${CMAKE_SOURCE_DIR}/launcher")
        get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
        foreach (target IN LISTS targets)
            get_target_property(type "${target}" TYPE)
            get_target_property(on_demand "${target}" EXCLUDE_FROM_ALL)
            if (type STREQUAL "EXECUTABLE" AND on_demand AND NOT target MATCHES "-marker$")
                list(APPEND tests "${target}")
            endif()
        endforeach()
    endforeach()
    list(SORT tests)
    list(JOIN tests "\n" text)
    file(CONFIGURE OUTPUT ${CMAKE_BINARY_DIR}/generated/sotb_test_targets.txt CONTENT "${text}\n" @ONLY)
endfunction()
