#include <winuser.h>
#include <winver.h>
#include "sotb_version.h"

1 ICON "../packaging/icons/app-icon.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "shadow_of_the_beast.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION SOTB_VERSION_NUMBERS
PRODUCTVERSION SOTB_VERSION_NUMBERS
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "saulob"
            VALUE "FileDescription", "Shadow of the Beast PC Port"
            VALUE "FileVersion", SOTB_FILE_VERSION_STRING
            VALUE "InternalName", "shadow_of_the_beast"
            VALUE "OriginalFilename", "shadow_of_the_beast.exe"
            VALUE "ProductName", "Shadow of the Beast PC Port"
            VALUE "ProductVersion", SOTB_VERSION_STRING
            VALUE "Comments", "https://github.com/saulob/shadow-of-the-beast-pc"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
